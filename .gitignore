# Local dev database - never commit real or dev data
data/app.db

# Local mesh uploads - user data, not code
data/meshes/*

# Generated datasets - regenerable from src/ml/generate_dataset*.py
data/lift_test_dataset*.csv

# Old file-based saved designs (superseded by the database)
data/saved_designs/

# Scratch test files created during development
*.stl
*.step
test_part.step

# Old RL experiment pickles - not needed for the deployed app
data/models/*.pkl
data/models/elbow_*.joblib
data/models/shoulder_*.joblib

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
venv/
.venv/

# Editor artifacts
*.bak

# Dev-only requirements (production uses requirements.txt)
requirements-dev.txt
